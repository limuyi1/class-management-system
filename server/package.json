{
  "name": "@class-management/server",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "lint": "eslint src tests --ext .ts,.mjs --ignore-path ../.eslintignore",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "admin:init": "tsx --env-file-if-exists=.env src/cli/admin.ts",
    "import:legacy": "tsx --env-file-if-exists=.env src/cli/importLegacy.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.49.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
