HOST=127.0.0.1
PORT=3000
DATABASE_PATH=../data/class-management.sqlite
WEB_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# 附件目录默认位于 DATABASE_PATH 所在目录下的 attachments，不放在公开静态目录
# ATTACHMENT_DIR=../data/attachments

# 首次启动自动生成 DATABASE_PATH 同目录下的 .ai-encryption-key；请单独备份此文件
# 可用 32 字节随机值的标准 Base64 覆盖自动文件，已有密文须使用原密钥
# AI_ENCRYPTION_KEY=
# AI_ENCRYPTION_KEY_FILE=../data/.ai-encryption-key

# 本地默认不信任转发头；仅在反向代理部署时填写确切代理 IP/CIDR，逗号分隔
# TRUST_PROXY=172.30.70.2
