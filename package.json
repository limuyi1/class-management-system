{
  "name": "class-management-system",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @class-management/ui --filter @class-management/server dev",
    "build": "pnpm --filter @class-management/ui build && pnpm --filter @class-management/server build",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm --filter @class-management/ui format",
    "admin:init": "pnpm --filter @class-management/server admin:init",
    "db:migrate": "pnpm --filter @class-management/server db:migrate",
    "convert:dexie": "node scripts/convert-dexie-backup.mjs",
    "migrate:student-ids": "node scripts/add-student-ids-to-dexie-backup.mjs",
    "import:legacy": "pnpm --filter @class-management/server import:legacy"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.3"
  }
}
