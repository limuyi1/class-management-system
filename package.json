{
  "name": "class-management-system",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "pnpm lint:check",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .eslintignore",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .eslintignore",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@google/generative-ai": "^0.24.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^10.7.1",
    "@vxe-ui/plugin-render-element": "~4.1.0",
    "dexie": "^4.4.1",
    "dexie-export-import": "^4.4.0",
    "dom-to-image": "^2.6.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "katex": "^0.16.44",
    "marked": "^17.0.5",
    "md-editor-v3": "^6.4.1",
    "pdf-lib": "^1.17.1",
    "pinia": "^2.1.7",
    "pinyin-pro": "^3.18.6",
    "tailwindcss": "^4.1.14",
    "vue": "^3.3.11",
    "vue-cropper": "^1.1.4",
    "vue-router": "^4.2.5",
    "vuedraggable": "^4.1.0",
    "vxe-pc-ui": "^4.9.44",
    "vxe-table": "~4.16.21",
    "xe-utils": "^3.7.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tailwindcss/vite": "^4.2.4",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.19.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "happy-dom": "^20.8.9",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "sass": "^1.99.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-html": "^3.2.2",
    "vitest": "4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
